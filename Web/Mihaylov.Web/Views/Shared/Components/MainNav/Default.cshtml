@model MainNavViewModel

@{
    const string Dir = "~/Views/Shared/Components/MainNav/";
}

<nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
    <div class="container-fluid">
        <a class="navbar-brand" href="@Url.Href(Model.Home)">Михайлов</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div id="navbarSupportedContent" class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
            <ul class="navbar-nav flex-grow-1">
                @foreach (var item in Model.MenuItems)
                {
                    if (item.Children == null)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="@Url.Href(item)">
                                <partial name="@(Dir + "_NavIconMenu.cshtml")" model="@item.Icon" />
                                @item.Title
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <partial name="@(Dir + "_NavIconMenu.cshtml")" model="@item.Icon" />
                                @item.Title
                            </a>
                            <div class="dropdown-menu">
                                @foreach (var child in item.Children)
                                {
                                    if (child.DividerBefore && child != item.Children.First())
                                    {
                                        <div class="dropdown-divider"></div>
                                    }
                                    <a class="dropdown-item text-dark" href="@Url.Href(child)">
                                        <partial name="@(Dir + "_NavIconMenu.cshtml")" model="@child.Icon" />
                                        @child.Title
                                    </a>
                                }
                            </div>
                        </li>
                    }
                }
            </ul>

            @if (!string.IsNullOrWhiteSpace(Model.Login?.PartialViewName))
            {
                <partial name="@Model.Login.PartialViewName" model="@Model.Home.MenuRoute" />
            }
        </div>
    </div>
</nav>
