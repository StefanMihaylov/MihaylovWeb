@model IEnumerable<ModuleDependenciesModel>

<h2>Dependencies</h2>

@foreach (var module in Model)
{
    <h4>@module.ModuleName</h4>
    <div class="row">
        <div class="col-md-6">
            <h6>Server</h6>
            <partial name="_DependencyTree" model="module.Server" />
        </div>
        <div class="col-md-6">
            <h6>UI</h6>
            <partial name="_DependencyTree" model="module.Ui" />
        </div>
    </div>
    <hr />
}