<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>0.2.2</Version>
		<PackageId>Mihaylov.Common.Database</PackageId>
		<Description>Shared Database utilities.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Mihaylov.Common.Core" Version="0.2.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
	</ItemGroup>
	
	<ItemGroup>
		<!--Overrides the Pkcs 9.0.11 package from SqlServer package because it has vulnerabilities; SqlClient contains Azure package -->
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	</ItemGroup>
</Project>
