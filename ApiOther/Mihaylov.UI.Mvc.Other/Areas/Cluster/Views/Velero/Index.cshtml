@model SchedulesMainModel

<div class="row h6">
    <div class="col-sm-2">
        <span>Velero schedules: @Model.Statistics.ScheduleCount</span>
    </div>
    <div class="col-sm-2">
        <span>24 часа: @Model.Statistics.LastDaySuccessfulBackupCount / @Model.Statistics.LastDayBackupCount</span>
    </div>
    <div class="col-sm-2">
        <span>7 дни: @Model.Statistics.LastWeekSuccessfulBackupCount / @Model.Statistics.LastWeekBackupCount</span>
    </div>
    <div class="col-sm-2">
        <span>Общо: @Model.Statistics.TotalSuccessfulBackupCount / @Model.Statistics.TotalBackupCount</span>
    </div>
    <div class="col-sm-2">
        <span>Velero: @Model.VeleroVersion</span>
    </div>
    <div class="col-sm-2">
    </div>
</div>

<div class="row">
    <table class="table table-bordered table-striped" id="schedule-grid">
        <thead>
            <tr>
                <th style="min-width:280px;">Name</th>
                <th style="min-width:100px;">CRON</th>
                <th></th>
                <th></th>
                <th></th>
                <th>Timeout</th>
                <th>Storage</th>
                <th></th>
                <th>Duration</th>
                <th style="min-width:100px;">Size SD</th>
                <th>Usage</th>
                <th style="min-width:100px;">Size</th>
                <th>Capacity</th>

                @foreach (var date in Model.Dates)
                {
                    <th>@date.ToString("d.M")</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var schedule in Model.Schedules)
            {
                <tr>
                    <td>@schedule.Name</td>
                    <td>@schedule.Cron</td>
                    <td>
                        <span data-container="body" data-toggle="popover" data-placement="top" data-content="@schedule.PopupContent" data-html="true">
                            <icon type="(schedule.Phase == SchedulePhaseType.Enabled ? IconType.Success : IconType.Warning)" />
                        </span>
                    </td>
                    <td>
                        @if (schedule.Phase == SchedulePhaseType.Enabled)
                        {
                            <icon type="(schedule.Paused != true ? IconType.Success : IconType.Pause)" />
                        }
                    </td>
                    <td>
                        @if (schedule.SnapshotMoveData)
                        {
                            <icon type="IconType.Storage" />
                        }
                    </td>
                    <td>@schedule.CsiSnapshotTimeout</td>
                    <td>@schedule.StorageClassType</td>
                    <td>
                        @if (schedule.Paused != true && schedule.Phase == SchedulePhaseType.Enabled)
                        {
                            <a href="@($"{Url.Href(new MenuRoute<VeleroController>(c => c.CreateBackup(string.Empty)))}?schedule={schedule.Name}")">
                                <icon type="IconType.Play2" />
                            </a>
                        }
                    </td>
                    <td>@schedule.Duration</td>
                    <td>
                        @if (schedule.SizeStandardDeviation.HasValue)
                        {
                            <span style=@(schedule.SizeDeviation > 10 ? "color:red" : string.Empty)>
                                @schedule.SizeStandardDeviation.Value.FormatBytes()
                            </span>
                        }
                    </td>
                    <td>
                        @if (schedule.VolumeUsage.HasValue)
                        {
                            <span style=@(schedule.VolumeUsage.Value > 75 ? "color:red" : string.Empty)>
                                @($"{schedule.VolumeUsage}%")
                            </span>
                        }
                    </td>
                    <td>
                        @if (schedule.Size.HasValue)
                        {
                            <span style=@(!schedule.IsSizeValid ? "color:red" : string.Empty)>
                                @schedule.Size.Value.FormatBytes()
                            </span>
                        }
                    </td>
                    <td>@schedule.Capacity?.FormatBytes()</td>

                    @foreach (var date in Model.Dates)
                    {
                        <td>
                            @foreach (var backup in schedule.BackupExtended)
                            {
                                @if (backup.CreatedOn.HasValue && backup.CreatedOn.Value.Date == date)
                                {
                                    <span data-container="body" data-toggle="popover" data-placement="top" data-content="@backup.PopupContent(Url.Href(new MenuRoute<VeleroController>(c => c.DeleteBackup(string.Empty))))" data-html="true">
                                        @if (backup.Phase == BackupPhaseType.Completed)
                                        {
                                            <icon type="IconType.Success" color=@(!backup.IsSizeValid ? "chocolate" : Colour.Green) />
                                        }
                                        else if (backup.Phase == BackupPhaseType.PartiallyFailed)
                                        {
                                            <icon type="IconType.Warning" />
                                        }
                                        else
                                        {
                                            <icon type="IconType.Question" color="lightgreen" />
                                        }
                                    </span>
                                }
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(function() {
            $('[data-toggle="popover"]').popover();
        });
    </script>
}
