@model NexusMainModel

<h3>Nexus blobs</h3>
<table class="table table-bordered table-striped" id="blob-grid">
    <tr>
        <th>Name</th>
        <th>Type</th>
        <th>Available</th>
        <th>Blob Count</th>
        <th>Total Size</th>
        <th>Available Space</th>
    </tr>

    @foreach (var blob in Model.Blobs.Blobs)
    {
        <tr>
            <td>@blob.Name</td>
            <td>@blob.Type</td>
            <td><icon type="(blob.Unavailable ? IconType.Up : IconType.Success)" /></td>
            <td>@blob.BlobCount</td>
            <td>@blob.TotalSizeInBytes.FormatBytes()</td>
            <td>@blob.AvailableSpaceInBytes.FormatBytes()</td>
        </tr>
    }
</table>

@{
    var runtimeCount = @Model.Images.Images.Select(s => s.Runtime).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().Count();
}

<h3>Nexus Images - @Model.Images.Images.Count() бр, Runtimes: @runtimeCount бр</h3>
<a class="btn btn-info" href="@Url.Href(new MenuRoute<NexusController>(c => c.Clear()))">Изчисти</a>

<table class="table table-bordered table-striped" id="images-grid">
    <tr>
        <th>Name</th>
        <th>Version</th>
        <th>Runtime</th>
        <th>Size - Layers</th>
        <th>App Size  - Layers</th>
        <th>Last Modified</th>
        <th>Action</th>
    </tr>

    @foreach (var image in Model.Images.Images)
    {
        <tr>
            <td>
                @if (image.IsFirst)
                {
                    @image.Name
                }
            </td>
            <td>
                <icon type="(image.IsLocked ? IconType.Success : IconType.Up)" />
                @image.Version
            </td>
            <td>@image.Runtime </td>
            <td>@($"{image.Size.FormatBytes()} - {image.LayersCount}")</td>
            <td>
                @if (image.AppSize.HasValue)
                {
                    @($"{image.AppSize.Value.FormatBytes()} - {image.AppLayersCount}")
                }
            </td>
            <td>@image.LastModified?.ToString(ViewConstants.DateTimeFormatSimple)</td>
            <td>
                @*                 <a href="@($"{Url.Href(new MenuRoute<NexusController>(c => c.DeleteImage("")))}?imageId={image.Id}")">
                    <icon type="IconType.DeleteFill" />
                </a> *@
            </td>
        </tr>
    }
</table>

<h3>Nexus Nugets - @Model.Images.Nugets.Count() бр, Types: @Model.Images.Nugets.Where(n => n.IsFirst).Count() бр</h3>

<table class="table table-bordered table-striped" id="nugets-grid">
    <tr>
        <th>Name</th>
        <th>Version</th>
        <th>Framework</th>
        <th>Size</th>
        <th>Local <icon type="IconType.Download" /></th>
        <th>External <icon type="IconType.Download" /></th>
        <th>Last Modified</th>
        <th>Action</th>
    </tr>

    @foreach (var nuget in Model.Images.Nugets)
    {
        <tr>
            <td>
                @if (nuget.IsFirst)
                {
                    @nuget.Name
                }

            </td>
            <td>
                <icon type="(nuget.IsLocked ? IconType.Success : IconType.Up)" />
                @nuget.Version
            </td>
            <td>@nuget.Runtime</td>
            <td>@nuget.Size.FormatBytes()</td>
            <td>@(nuget.LocalDependenciesCount > 0 ? nuget.LocalDependenciesCount : string.Empty)</td>
            <td>@(nuget.ExternalDependenciesCount > 0 ? nuget.ExternalDependenciesCount : string.Empty)</td>
            <td>@nuget.LastModified?.ToString(ViewConstants.DateTimeFormatSimple)</td>
            <td>
                @*                 <a href="@($"{Url.Href(new MenuRoute<NexusController>(c => c.DeleteImage("")))}?imageId={nuget.Id}")">
                    <icon type="IconType.DeleteFill" />
                </a> *@
            </td>
        </tr>
    }
</table>

@{
    string GetFootprintIncrease(MicrosoftRuntime runtime)
    {
        if (!runtime.FootprintIncrease.HasValue)
        {
            return string.Empty;
        }

        if (runtime.FootprintIncrease.Value == runtime.Size)
        {
            return "Full";
        }

        return runtime.FootprintIncrease.Value.FormatBytes();
    }
}

<h3> Runtimes: @Model.Images.Runtimes.Count() бр </h3>
<table class="table table-bordered table-striped" id="runtimes-grid">
    <tr>
        <th>Name</th>
        <th>Release Date</th>
        <th>Size</th>
        <th>Layers Count</th>
        <th>Size Increase</th>
        <th>Footprint Increase</th>
    </tr>

    @foreach (var runtime in Model.Images.Runtimes)
    {
        <tr>
            <td>@runtime.Runtime</td>
            <td>@runtime.ReleaseDate?.ToString(ViewConstants.DateFormatSimple)</td>
            <td>@runtime.Size.FormatBytes()</td>
            <td>@runtime.LayersCount</td>
            <td>@(runtime.SizeIncrease.HasValue ? runtime.SizeIncrease.Value.FormatBytes() : string.Empty)</td>
            <td>@GetFootprintIncrease(runtime)</td>
        </tr>
    }

</table>