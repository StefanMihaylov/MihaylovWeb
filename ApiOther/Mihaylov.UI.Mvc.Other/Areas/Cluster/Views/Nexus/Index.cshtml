@model NexusMainModel

<h3>Nexus blobs</h3>
<table class="table table-bordered table-striped" id="blob-grid">
    <tr>
        <th>Name</th>
        <th>Type</th>
        <th>Available</th>
        <th>BlobCount</th>
        <th>TotalSize</th>
        <th>AvailableSpace</th>
    </tr>

    @foreach (var blob in Model.Blobs.Blobs)
    {
        <tr>
            <td>@blob.Name</td>
            <td>@blob.Type</td>
            <td>
                @if (blob.Unavailable)
                {
                    <span style="color:red">
                        <i class="bi bi-shift-fill"></i>
                    </span>
                }
                else
                {
                    <span style="color:green">
                        <i class="bi bi-check-circle-fill"></i>
                    </span>
                }
            </td>
            <td>@blob.BlobCount</td>
            <td>@blob.TotalSizeInBytes.FormatBytes()</td>
            <td>@blob.AvailableSpaceInBytes.FormatBytes()</td>
        </tr>
    }
</table>

@{
    var runtimeCount = @Model.Images.Images.Select(s => s.Runtime).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().Count();
}

<h3>Nexus Images - @Model.Images.Images.Count() бр, Runtimes: @runtimeCount бр</h3>
<a class="btn btn-info" href="@Url.Href(new MenuRoute<NexusController>(c => c.Clear()))">Изчисти</a>

<table class="table table-bordered table-striped" id="images-grid">
    <tr>
        <th>Name</th>
        <th>Version</th>
        <th>Runtime</th>
        <th>Size - Layers</th>
        <th>App Size  - Layers</th>
        <th>LastModified</th>
        <th>Action</th>
    </tr>

    @foreach (var image in Model.Images.Images)
    {
        <tr>
            <td>
                @if (image.IsFirst)
                {
                    @image.Name
                }

            </td>
            <td>
                @if (!@image.IsLocked)
                {
                    <span style="color:red">
                        <i class="bi bi-shift-fill"></i>
                    </span>
                }
                else
                {
                    <span style="color:green">
                        <i class="bi bi-check-circle-fill"></i>
                    </span>
                }

                @image.Version
            </td>
            <td>@image.Runtime </td>
            <td>@($"{image.Size.FormatBytes()} - {image.LayersCount}")</td>
            <td>
                @if (image.AppSize.HasValue)
                {
                    @($"{image.AppSize.Value.FormatBytes()} - {image.AppLayersCount}")
                }
            </td>
            <td>@image.LastModified?.ToString(ViewConstants.DateTimeFormatSimple)</td>
            <td>
@*                 <a href="@($"{Url.Href(new MenuRoute<NexusController>(c => c.DeleteImage("")))}?imageId={image.Id}")">
                    <span style="color:red">
                        <i class="bi @ViewConstants.CloseCircleButton"></i>
                    </span>
                </a> *@
            </td>
        </tr>
    }
</table>

<h3>Nexus Nugets - @Model.Images.Nugets.Count() бр, Types: @Model.Images.Nugets.Where(n => n.IsFirst).Count() бр</h3>

<table class="table table-bordered table-striped" id="nugets-grid">
    <tr>
        <th>Name</th>
        <th>Version</th>
        <th>Size</th>
        <th>LastModified</th>
        <th>Action</th>
    </tr>

    @foreach (var nuget in Model.Images.Nugets)
    {
        <tr>
            <td>
                @if (nuget.IsFirst)
                {
                    @nuget.Name
                }

            </td>
            <td>
                @if (!@nuget.IsLocked)
                {
                    <span style="color:red">
                        <i class="bi bi-shift-fill"></i>
                    </span>
                }
                else
                {
                    <span style="color:green">
                        <i class="bi bi-check-circle-fill"></i>
                    </span>
                }

                @nuget.Version
            </td>
            <td>@nuget.Size.FormatBytes()</td>
            <td>@nuget.LastModified?.ToString(ViewConstants.DateTimeFormatSimple)</td>
            <td> </td>
        </tr>
    }
</table>