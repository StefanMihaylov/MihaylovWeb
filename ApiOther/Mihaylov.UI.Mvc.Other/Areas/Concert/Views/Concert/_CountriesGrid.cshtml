@model CountriesViewModel

<div class="col-md-6 country-grid">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>@Html.LabelFor(m => m.Countries.Data.First().Name)</th>
                <th>@Html.LabelFor(m => m.Countries.Data.First().Code)</th>
                <th>@Html.LabelFor(m => m.Countries.Data.First().BandCount)</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var country in Model.Countries.Data)
            {
                <tr>
                    <td>@country.Name</td>
                    <td>@country.Code</td>
                    <td>@country.BandCount</td>
                    <td>
                        <span class="btn btn-sm btn-secondary edit-country-btn" data-id="@country.Id" data-name="@country.Name" data-code="@country.Code">
                            Редактирай
                        </span>
                    </td>
                </tr>
            }

            <form action="@Url.Href(new MenuRoute<ConcertController>(c => c.Country(null)))" method="post">
            <tr>
                <td>
                    <input type="hidden" id="country-id-input" name="Id" value="" />
                    <input type="text" id="new-country-name-input" name="Name" placeholder="Добави нов" role="presentation" aria-autocomplete="none" autocomplete="false" />
                    @Html.ValidationMessage("Name")
                    <input type="text" id="new-country-code-input" name="Code" placeholder="Добави код" role="presentation" aria-autocomplete="none" autocomplete="false" />
                    @Html.ValidationMessage("Name")
                </td>
                <td></td>
                <td>
                    <input type="submit" class="btn btn-primary" value="Добави" />
                    <span class="btn btn-secondary country-cancel-btn">Отказ</span>
                </td>
            </tr>
            </form>
        </tbody>
    </table>

    @await Html.PartialAsync("_Pagination", new PagerExtended(Model.Countries.Pager, Model.Request, Url.Href(new MenuRoute<ConcertController>(c => c.Index(null))), "countries"))
</div>
