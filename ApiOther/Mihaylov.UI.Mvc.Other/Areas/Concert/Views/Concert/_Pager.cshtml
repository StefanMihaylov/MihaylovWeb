@model PagerExtended

@{
    string GetUrl(int? page, string tab)
    {
        return $"{Url.Href(new MenuRoute<ConcertController>(c => c.Index(null, null)))}?page={page}&activeTab={tab}";
    }
}

<div class="col-auto">
    <nav aria-label="">
        <ul class="pagination ustify-content-end">
            <li class="page-item">
                <a class="page-link" href="@GetUrl(Model.Pager.Page - 1, Model.ActiveTab)">Previous</a>
            </li>

            @for (int i = 1; i <= Model.Pager.PageMax; i++)
            {
                if (i == Model.Pager.Page)
                {
                    <li class="page-item active">
                        <span class="page-link">
                            @(i)
                            <span class="sr-only">(current)</span>
                        </span>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" href="@GetUrl(i, Model.ActiveTab)"> @(i)</a>
                    </li>
                }
            }

            <li class="page-item">
                <a class="page-link" href="@GetUrl(Model.Pager.Page + 1, Model.ActiveTab)">Next</a>
            </li>

            <li class="page-item disabled">
                <span class="page-link">x @Model.Pager.PageSize</span>
            </li>
        </ul>
    </nav>
</div>