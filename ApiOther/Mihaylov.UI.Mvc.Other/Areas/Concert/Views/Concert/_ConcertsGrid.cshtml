@model ConcertViewModel

<div class="col-md-12 concert-grid">
    @Html.ValidationSummary()
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>@Html.NameFor(m => m.Concerts.Data.First().Date)</th>
                <th>@Html.NameFor(m => m.Concerts.Data.First().Name)</th>
                <th>@Html.NameFor(m => m.Concerts.Data.First().Bands)</th>
                <th>@Html.NameFor(m => m.Concerts.Data.First().ConcertType)</th>
                <th>@Html.NameFor(m => m.Concerts.Data.First().Price)</th>
                <th>@Html.NameFor(m => m.Concerts.Data.First().Currency)</th>
                <th>@Html.NameFor(m => m.Concerts.Data.First().Location)</th>
                <th>@Html.NameFor(m => m.Concerts.Data.First().TicketProvider)</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @await Html.PartialAsync("_AddConcert", Model.Input)

            @foreach (var concert in Model.Concerts.Data)
            {
                <tr>
                    <td>@concert.Date.ToString("yyyy.MM.dd")</td>
                    <td>@concert.Name</td>
                    <td>@string.Join(", ", concert.Bands?.Select(b => b?.Name))</td>
                    <td>@concert.ConcertType</td>
                    <td>@concert.Price </td>
                    <td>@concert.Currency </td>
                    <td>@concert.Location</td>
                    <td>@concert.TicketProvider</td>
                    <td>
                        <span class="btn btn-sm btn-secondary edit-concert-btn" data-id="@concert.Id" data-date="@concert.Date.ToString("yyyy.MM.dd")" data-json='@Json.Serialize(concert)'>
                            Редактирай
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @await Html.PartialAsync("_Pagination", new PagerExtended(Model.Concerts.Pager, Model.Request, Url.Href(new MenuRoute<ConcertController>(c => c.Index(null))), "concerts"))
</div>