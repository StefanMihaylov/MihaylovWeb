@model CurrentWeatherResponse

<tr>
    <td>@Model.Location</td>
    <td>@Model.CurrentDate</td>
    <td>@Model.Condition</td>
    <td>        
        @if (!string.IsNullOrEmpty(Model.ConditionIcon))
        {
            <img src=@Model.ConditionIcon width="40" height="40" />
        }        
    </td>
    <td>@Model.Temperature</td>
    <td>@Model.FeelsLike</td>
    <td>@Model.Wind</td>
</tr>
