@using Mihaylov.Api.Other.Client;
@using Mihaylov.Common
@using Mihaylov.UI.Mvc.Other.Areas.Gallery.Controllers
@model IEnumerable<AlbumModel>

@section Styles {
    <link rel="stylesheet" href="/_content/mihaylov.ui.mvc.other/css/gallery.css" asp-append-version="true" />
}

<div class="row">
    @foreach (var album in Model)
    {
        <div class="col-md-2" id="gallery-container">
            <a href="@album.AlbumLink" target="_blank" class="gallery-link">
                <div class="gallery-wraper">
                    <img src="@($"{Url.Href(new MenuRoute<GalleryController>(c => c.Thumbnail("")))}/{album.ThumbnailAssetId}")" />
                    <div class="gallery-caption">
                        <div class="title">@album.Name</div>
                        <div>@album.StartDate.ToString("dd.MM") - @album.EndDate.ToString("dd.MM.yyyy")</div>
                        <div>@album.AssetCount снимки</div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>