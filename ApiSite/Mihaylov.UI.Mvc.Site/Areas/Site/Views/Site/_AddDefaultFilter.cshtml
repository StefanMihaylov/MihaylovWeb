@model DefaultFilterExtended

@{
    var accountTypes = Model.AccountTypes.GetListItems(u => u.Id, u => u.Name);
    var accountStates = Model.States.GetListItems(u => u.Id, u => u.Name);
    var boolValues = new[] { false, true }.GetListItems(u => u.ToString(), u => u.ToString());
}

<form action="@Url.Href(new MenuRoute<SiteController>(c => c.SaveDefaultFilter(null)))" method="post" class="form">
    <fieldset>
        <div class="form-row">
            <div class="form-group col-auto">
                @Html.LabelFor(m => Model.IsEnabled)
                @Html.DropDownListFor(m => Model.IsEnabled, boolValues, ViewConstants.DefaultDropDownValue, new { @class = "form-control", style = "width:200px" })
                @Html.ValidationMessageFor(m => Model.IsEnabled)
            </div>
            <div class="form-group col-auto">
                @Html.LabelFor(m => Model.AccountTypeId, "Type")
                @Html.DropDownListFor(m => Model.AccountTypeId, accountTypes, ViewConstants.DefaultDropDownValue, new { @class = "form-control", style = "width:200px" })
            </div>
            <div class="form-group col-auto">
                @Html.LabelFor(m => Model.StatusId, "Status")
                @Html.DropDownListFor(m => Model.StatusId, accountStates, ViewConstants.DefaultDropDownValue, new { @class = "form-control", style = "width:200px" })
            </div>
            <div class="form-group col-auto">
                @Html.LabelFor(m => Model.IsArchive)
                @Html.DropDownListFor(m => Model.IsArchive, boolValues, ViewConstants.DefaultDropDownValue, new { @class = "form-control", style = "width:200px" })
                @Html.ValidationMessageFor(m => Model.IsArchive)
            </div>
            <div class="form-group col-auto">
                @Html.LabelFor(m => Model.IsPreview)
                @Html.DropDownListFor(m => Model.IsPreview, boolValues, ViewConstants.DefaultDropDownValue, new { @class = "form-control", style = "width:200px" })
            </div>
            <div class="form-group col-auto">
                @Html.HiddenFor(m => Model.Id)
                <button type="submit" class="submit-btn btn btn-primary">
                    <icon type="IconType.Save" />
                </button>
                <span class="btn btn-danger close-default-filter-button">
                    <icon type="IconType.Close" color=@Colour.Disabled />
                </span>
            </div>
        </div>
    </fieldset>
</form>
