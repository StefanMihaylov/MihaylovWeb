@using Mihaylov.Api.Site.Client
@model AccountType

<form action="@Url.Href(new MenuRoute<SiteController>(c => c.SaveAccountType(null)))" method="post">
    <div class="form-row">
        <div class="form-group col-auto">
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", style = "width:500px", aria_autocomplete = "none", autocomplete = "off" })
        </div>

        <div class="form-group col-auto">
            @Html.HiddenFor(m => Model.Id)
            <button type="submit" class="submit-btn btn btn-primary">
                <icon type="IconType.Save" />
            </button>
            <span class="btn btn-danger close-account-type-button">
                <icon type="IconType.Close" color=@Colour.Disabled />
            </span>
        </div>
    </div>
</form>
