@using Mihaylov.UI.Mvc.Users.Areas.Identity.Pages.Account
@using Mihaylov.UI.Mvc.Users.Areas.Identity.Pages.Account.Manage
@model IMenuRoute

<ul class="navbar-nav">
    @if (User.Identity.IsAuthenticated)
    {
        <li class="nav-item">
            <a class="nav-link text-dark" href="@Url.Href(new MenuRoute<IndexModel>())">Hello @User.GetName()</a>
        </li>
        <li class="nav-item">
            <form class="form-inline" method="post" asp-antiforgery="true"
                  action="@($"{Url.Href(new MenuRoute<LogoutModel>())}?returnUrl={WebUtility.UrlEncode(Url.Href(Model))}")">
                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" href="@Url.Href(new MenuRoute<RegisterModel>())">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" href="@Url.Href(new MenuRoute<LoginModel>())">Login</a>
        </li>
    }
</ul>